{
  "name": "brc",
  "private": true,
  "version": "2.0.5",
  "description": "Better Remote Commander (BRC) - self-hosted remote desktop agent + MCP relay for Claude and ChatGPT",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "clean": "pnpm -r --filter \"./packages/*\" exec rimraf dist",
    "typecheck": "pnpm -r --filter \"./packages/*\" exec tsc --noEmit",
    "agent": "pnpm --filter brc-agent start",
    "relay": "pnpm --filter brc-relay start",
    "dev:relay": "pnpm --filter brc-relay build && node packages/relay/dist/cli.js",
    "dev:agent": "pnpm --filter brc-agent build && node packages/agent/dist/cli.js",
    "extract-tools": "node scripts/extract-tools.mjs",
    "catalog:update": "node scripts/generate-relay-catalog.mjs",
    "catalog:check": "node scripts/generate-relay-catalog.mjs --check",
    "pack:all": "pnpm -r --filter \"./packages/*\" exec pnpm pack --pack-destination ../../dist-pack",
    "publish:all": "pnpm -r --filter \"./packages/*\" publish --access public",
    "test:unit": "node --test packages/relay/test/unit.test.mjs",
    "test:mongo": "node packages/relay/test/mongo.e2e.mjs",
    "test:e2e": "node scripts/e2e-all.mjs",
    "test": "pnpm test:unit && pnpm test:agent && pnpm test:e2e",
    "test:agent": "node --test packages/agent/test/*.test.mjs",
    "bench:context": "node scripts/benchmark-context.mjs",
    "bench:io": "node scripts/benchmark-roundtrips.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0"
  }
}
