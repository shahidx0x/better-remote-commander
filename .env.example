# --- SES-RDP relay configuration (copy to .env) ---
# Public HTTPS URL clients use. Drives OAuth issuer + redirect validation. No trailing slash.
PUBLIC_URL=https://rdp.example.com
TRUST_PROXY=true
SES_RDP_ADMIN_USER=admin
SES_RDP_ADMIN_PASSWORD=change-me
# random string, e.g. openssl rand -hex 32
SES_RDP_SESSION_SECRET=change-me-too
LOG_LEVEL=info

# local / tunnel profiles: where the relay is published on the host
PORT=3000
BIND_ADDR=127.0.0.1

# tunnel + cloudflare: create a tunnel in Zero Trust -> Networks -> Tunnels, route hostname -> http://relay:3000
CLOUDFLARE_TUNNEL_TOKEN=

# tunnel + ngrok: reserve a static domain in the ngrok dashboard (free tier includes one)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app

# cloud: DNS A/AAAA record for DOMAIN must point to this VPS; ports 80/443 open
DOMAIN=rdp.example.com
