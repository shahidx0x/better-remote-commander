# --- BRC relay configuration (copy to .env) ---
# Public HTTPS URL clients use. Drives OAuth issuer + redirect validation. No trailing slash.
PUBLIC_URL=https://rdp.example.com
TRUST_PROXY=true
BRC_ADMIN_USER=admin
BRC_ADMIN_PASSWORD=change-me
# random string, e.g. openssl rand -hex 32
BRC_SESSION_SECRET=change-me-too
LOG_LEVEL=info

# Storage: SQLite is the default. Persist /data with a volume when using SQLite.
BRC_DB=/data/relay.sqlite
# Optional: supplying MONGODB_URI switches persistent storage to MongoDB instead.
# Use a dedicated database on a MongoDB service with its OWN persistent disk.
# MONGODB_URI=mongodb://USER:PASSWORD@mongo-host:27017/brc_relay?authSource=admin
MONGODB_URI=
MONGODB_DB=

# Optional skills.sh catalog integration: requires a short-lived Vercel OIDC bearer token.
# Without it, the Skills library supports manual owner-approved SKILL.md imports.
# BRC_SKILLS_API_TOKEN=

# Provider-reported token analytics needs no extra env: send actual model usage
# with an owner-created API key to POST /api/usage/report (see docs/relay-skills-usage.md).

# local / tunnel profiles: where the relay is published on the host
PORT=3000
BIND_ADDR=127.0.0.1

# tunnel + cloudflare: create a tunnel in Zero Trust -> Networks -> Tunnels, route hostname -> http://relay:3000
CLOUDFLARE_TUNNEL_TOKEN=

# tunnel + ngrok: reserve a static domain in the ngrok dashboard (free tier includes one)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app

# cloud: DNS A/AAAA record for DOMAIN must point to this VPS; ports 80/443 open
DOMAIN=rdp.example.com
