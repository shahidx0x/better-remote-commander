# --- BRC relay configuration (copy to .env) ---
# Public HTTPS URL clients use. Drives OAuth issuer + redirect validation. No trailing slash.
PUBLIC_URL=https://rdp.example.com
TRUST_PROXY=true
BRC_ADMIN_USER=admin
BRC_ADMIN_PASSWORD=change-me
# random string, e.g. openssl rand -hex 32
BRC_SESSION_SECRET=change-me-too
LOG_LEVEL=info

# Storage: SQLite is the default. Persist /data with a volume when using SQLite.
BRC_DB=/data/relay.sqlite
# Optional: supplying MONGODB_URI switches persistent storage to MongoDB instead.
# Use a dedicated database on a MongoDB service with its OWN persistent disk.
# MONGODB_URI=mongodb://USER:PASSWORD@mongo-host:27017/brc_relay?authSource=admin
MONGODB_URI=
MONGODB_DB=

# Optional skills.sh catalog integration: requires a short-lived Vercel OIDC bearer token.
# Without it, the Skills library supports manual owner-approved SKILL.md imports.
# BRC_SKILLS_API_TOKEN=

# MCP discovery profile served by this RELAY: core (default 34 agent tools),
# focused (44), or full (60). Retired duplicates are excluded in every profile.
# Original handlers remain installed for backward compatibility and workers.
# ChatGPT needs an app/tool refresh after changing the relay profile.
BRC_MCP_TOOL_PROFILE=core

# Durable operation recovery is ON by default with the existing relay DB.
# Mutation claims are saved before dispatch; no automatic retry of uncertain work.
# Result payloads are encrypted with the STABLE BRC_SESSION_SECRET when it has
# at least 32 characters. Keep the same secret when redeploying the relay.
# Optional: BRC_RECOVERY_ENCRYPTION_KEY can use a separate long-lived key.
# Optional: BRC_DURABLE_RESULT_PAYLOADS=0 keeps metadata but omits full encrypted results.
# 7-day retention, up to 512 KiB plaintext per result, 64 MiB stored ciphertext.
# Details: docs/durable-operation-recovery.md

# Local AGENT setting (not needed on the relay): BRC_MAX_RESULT_BYTES=524288
# Result WebSocket frame budget defaults to 512 KiB (min 64 KiB, max 512 KiB).
# The relay has an independent 512 KiB fallback to protect legacy agents.

# Automatic tool-visible token estimates are enabled by default: local BPE worker,
# 4-second batch writes, SQLite/MongoDB per-account daily counters, no ChatGPT API.
# BRC_MCP_TOKEN_ESTIMATES=1
# Set to 0 to disable; these are NOT full model/chat token counts.

# Optional provider-reported token analytics needs no extra env: send actual model usage
# with an owner-created API key to POST /api/usage/report (see docs/relay-skills-usage.md).

# local / tunnel profiles: where the relay is published on the host
PORT=3000
BIND_ADDR=127.0.0.1

# tunnel + cloudflare: create a tunnel in Zero Trust -> Networks -> Tunnels, route hostname -> http://relay:3000
CLOUDFLARE_TUNNEL_TOKEN=

# tunnel + ngrok: reserve a static domain in the ngrok dashboard (free tier includes one)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app

# cloud: DNS A/AAAA record for DOMAIN must point to this VPS; ports 80/443 open
DOMAIN=rdp.example.com
