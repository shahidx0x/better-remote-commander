{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BRC: build",
      "type": "process",
      "command": "pnpm",
      "windows": {
        "command": "pnpm.cmd"
      },
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "group": "build"
    },
    {
      "label": "BRC: typecheck",
      "type": "process",
      "command": "pnpm",
      "windows": {
        "command": "pnpm.cmd"
      },
      "args": [
        "typecheck"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "BRC: test",
      "type": "process",
      "command": "pnpm",
      "windows": {
        "command": "pnpm.cmd"
      },
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "BRC: start local agent (saved pairing)",
      "type": "process",
      "command": "node",
      "args": [
        "packages/agent/dist/cli.js"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "BRC: connection settings",
      "type": "process",
      "command": "node",
      "args": [
        "packages/agent/dist/cli.js",
        "--setup"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
