{
    "name": "brc-relay",
    "version": "2.0.5",
    "description": "BRC relay - self-hosted MCP + REST server that routes tool calls to paired device agents",
    "license": "MIT",
    "type": "module",
    "bin": {
        "brc-relay": "dist/cli.js"
    },
    "main": "dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/cli.js",
        "migrate:sqlite-to-mongo": "node dist/store/migrate.js",
        "dev": "tsc -p tsconfig.json --watch"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.9.0",
        "brc-shared": "workspace:*",
        "cookie-parser": "^1.4.7",
        "express": "^5.1.0",
        "mongodb": "7.9.0",
        "ws": "^8.18.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.8",
        "@types/express": "^5.0.1",
        "@types/ws": "^8.5.12"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/shahidx0x/better-remote-commander.git",
        "directory": "packages/relay"
    },
    "engines": {
        "node": ">=22.13"
    },
    "homepage": "https://github.com/shahidx0x/better-remote-commander#readme",
    "keywords": [
        "mcp",
        "claude",
        "chatgpt",
        "remote-desktop",
        "remote-control",
        "terminal",
        "agent",
        "self-hosted",
        "desktop-commander"
    ]
}
